#!/usr/bin/env python3
"""The playbook's golden tests: renders every fixture in tests/golden/ with
tests/render.yml and compares each file, byte for byte, with its .golden.
Secrets are filled in as files/gitea-render-secrets does on the VM.

  tests/check            compare (PR previews and deploys run this, through
                         infra_deploy.py's ansible_checks; so does `make check`)
  tests/check --update   rewrite the goldens from what renders now (`make
                         goldens`); review their diff in the PR -- it is the
                         rendered effect of a template or variable change

Before rendering, every ${VAR} in a templated file is checked against what
defines it, so a new variable fails here with what to add, not as an Ansible
"undefined variable" deep in a deploy. The first goldens were written by
tests/make-goldens the way vm/bootstrap.sh rendered, which proved the cutover
byte for byte; from then on --update is how they change.

Once the goldens match, Caddy's stop budget and the telemetry to watchtower are
checked too (not under --update). Everywhere, as they need nothing downloaded:
  - Caddy's stop budget (caddy_stop_budget): every fixture's Caddyfile sets a
    grace_period, and its shutdown_delay + grace_period + 3 s fits in
    caddy.container's explicit StopTimeout, itself under TimeoutStopSec;
  - the watchtower peer script over made-up configs (scripts/check-peer-config.sh);
  - role tunnel's state over every case (tests/tunnel-state.yml);
  - that the metadata guard in the ruleset names Alloy's uid and Gitea's
    address, and not Caddy's (scripts/check-metadata-guard.sh --static).
In a PR preview, `make check` and by hand, also, failing hard:
  - `alloy fmt --test` and `alloy validate` on every fixture's rendered config;
  - its scrub rules over scripts/testdata/scrub.log and scrub.caddy.log
    (scripts/check-alloy-scrub.sh).
Those two need Alloy and jq, downloaded pinned by sha256 (TOOLS) into
~/.cache/gitea-vm-checks. A deploy (infra_deploy.py up) and `make
vm-check`/`vm-apply` skip them, so a deploy never waits on github.com or fails
on telemetry: the PR preview of the same tree ran them. See run_mode().

Run with ansible-core on PATH (`make goldens` and `make ansible-check` do).
"""
import argparse
import difflib
import hashlib
import os
import platform
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.request
import zipfile

import yaml

HERE = os.path.dirname(os.path.abspath(__file__))
ANSIBLE = os.path.dirname(HERE)
VM = os.path.dirname(ANSIBLE)
ROOT = os.path.dirname(VM)
SECRETS = {"app.ini": ["GITEA_SECRET_KEY", "GITEA_INTERNAL_TOKEN", "GITEA_OAUTH2_JWT_SECRET", "GITEA_LFS_JWT_SECRET"],
           "Caddyfile": ["CADDY_EMAIL"]}
# The directories whose files are rendered with ${ } delimiters.
TEMPLATED = ["config", "quadlets", "nftables", "fail2ban/jail.d"]
VARS_FILES = ["roles/app/vars/main.yml", "roles/firewall/vars/main.yml", "roles/logship/vars/main.yml"]
HELPER = "roles/app/files/gitea-render-secrets"
VAR = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}")

# The tools the download-needing telemetry checks run, per Linux machine type
# (the deploy image is x86_64; a workstation may be either): name -> (url, the
# sha256 its release publishes, the member to take from a zip or None). Alloy
# is the version watchtower's contract pins (v1.21.3, as in
# vm/quadlets/alloy.container), from the release's SHA256SUMS; jq, which
# scripts/check-alloy-scrub.sh reads Alloy's log with and the deploy image
# lacks, from its release's sha256sum.txt. Bump them here by hand.
TOOLS = {
    "x86_64": {
        "alloy": ("https://github.com/grafana/alloy/releases/download/v1.21.3/alloy-linux-amd64.zip",
                  "50d23af2d0f98c00beac6ce9a365693e60f87fb76b6cad6fe1d161e80588af6d", "alloy-linux-amd64"),
        "jq": ("https://github.com/jqlang/jq/releases/download/jq-1.8.2/jq-linux-amd64",
               "b1c22172dd303f3be49e935aa56aa48a8b7a46e0bc838b4997d3bb451495870f", None),
    },
    "aarch64": {
        "alloy": ("https://github.com/grafana/alloy/releases/download/v1.21.3/alloy-linux-arm64.zip",
                  "ca2f383cc60491877b21aef50c54af6a198f6c861c2c4b80f41ec49ad73b1b93", "alloy-linux-arm64"),
        "jq": ("https://github.com/jqlang/jq/releases/download/jq-1.8.2/jq-linux-arm64",
               "8b85c817833814ddca00a144c33705546355afccf0cf39b188f3cdb48b852309", None),
    },
}
ALLOY_CONFIG = "config.alloy"  # the rendered name of vm/config/config.alloy.tmpl
# Caddy's stop budget (caddy_stop_budget). The rendered names of
# vm/config/Caddyfile.tmpl and vm/quadlets/caddy.container; the seconds left,
# after Caddy's grace period, for it to close its listeners and exit before
# podman's SIGKILL; and systemd's TimeoutStopSec when a unit sets none.
CADDYFILE = "Caddyfile"
CADDY_QUADLET = "caddy.container"
CADDY_STOP_MARGIN = 3
SYSTEMD_STOP_TIMEOUT = 90
# A Caddy duration (caddy.ParseDuration): Go's, a sequence such as 5s, 500ms or
# 1m30s, plus d for days.
CADDY_DURATION_UNITS = {"ns": 1e-9, "us": 1e-6, "ms": 1e-3, "s": 1, "m": 60, "h": 3600, "d": 86400}
CADDY_DURATION_PART = r"(\d+(?:\.\d+)?)(ns|us|ms|s|m|h|d)"
# A systemd time span (systemd.time(7)), as TimeoutStopSec= takes it: seconds
# alone, or numbers with units such as "1min 30s"; or infinity.
SYSTEMD_TIME_UNITS = {"": 1, "us": 1e-6, "usec": 1e-6, "ms": 1e-3, "msec": 1e-3, "s": 1, "sec": 1, "m": 60,
                      "min": 60, "h": 3600, "hr": 3600}
SYSTEMD_TIME_PART = r"\s*(\d+(?:\.\d+)?)\s*([a-z]*)"
SCRUB_FIXTURE = os.path.join(ROOT, "scripts", "testdata", "scrub.log")
# infra_deploy.py's modes that change, or read, the VM: the deploy, and `make
# vm-check`/`vm-apply` (also ci-vm-check/ci-vm-apply). Its other, `preview`, is
# a pull request's.
DEPLOY_MODES = {"up", "vm-check", "vm-apply"}
MODES = DEPLOY_MODES | {"preview"}


def run_mode():
    """"deploy" when infra_deploy.py runs this for a deploy or a vm-check or
    vm-apply, "strict" otherwise: a PR preview, `make check`, by hand.

    infra_deploy.py and cloudbuild/infra.yaml are release-gate files, and the
    environment it hands this is the same in a preview as in a deploy. What
    differs is its own command line: it runs this directly (subprocess, no
    shell), so the parent process is infra_deploy.py, and its mode is the one
    positional argument with fixed choices (MODES). Read from
    /proc/<parent>/cmdline. Anything unrecognised is strict, so a check can
    only ever be skipped by a deploy-mode parent.

    GITEA_CHECK_MODE=strict|deploy decides instead, for testing this."""
    forced = os.environ.get("GITEA_CHECK_MODE", "")
    if forced:
        if forced not in ("strict", "deploy"):
            raise SystemExit(f"tests/check: GITEA_CHECK_MODE={forced!r}: strict or deploy")
        return forced
    try:
        with open(f"/proc/{os.getppid()}/cmdline", "rb") as fh:
            argv = [a.decode(errors="replace") for a in fh.read().split(b"\0") if a]
    except OSError:
        return "strict"
    for i, arg in enumerate(argv):
        if os.path.basename(arg) == "infra_deploy.py":
            mode = next((a for a in argv[i + 1:] if a in MODES), "")
            return "deploy" if mode in DEPLOY_MODES else "strict"
    return "strict"


def check_variables():
    """Problems with the templates' ${VAR}s, as messages saying what to add."""
    defined = {}
    for f in VARS_FILES:
        with open(os.path.join(ANSIBLE, f)) as fh:
            for k, v in (yaml.safe_load(fh) or {}).items():
                defined[k] = (f, v)
    # What tests/render.yml renders: its loops' src entries (the app.ini and
    # Caddyfile ones are relative to vm/config).
    with open(os.path.join(ANSIBLE, "tests", "render.yml")) as fh:
        play = yaml.safe_load(fh)[0]
    rendered = {i["src"] if "/" in i["src"] else "config/" + i["src"]
                for t in play["tasks"] for i in (t.get("loop") or []) if isinstance(i, dict) and "src" in i}
    with open(os.path.join(ANSIBLE, HELPER)) as fh:
        helper = fh.read()
    problems = []
    for d in TEMPLATED:
        for name in sorted(os.listdir(os.path.join(VM, d))):
            rel = f"{d}/{name}"
            if not os.path.isfile(os.path.join(VM, rel)):
                continue
            if rel not in rendered:
                problems.append(f"vm/{rel} is not rendered by tests/render.yml: add it there (and to a role), "
                                "then `make goldens`")
            with open(os.path.join(VM, rel)) as fh:
                used = sorted(set(VAR.findall(fh.read())))
            for v in used:
                if v not in defined:
                    problems.append(
                        f"vm/{rel} uses ${{{v}}}, which nothing defines: add {v} to {VARS_FILES[0]} (config, "
                        f"quadlets) or {VARS_FILES[1]} (nftables, jail) -- from a metadata fact the preflight role "
                        "sets, which every tests/golden/*/fixture.yml then needs a value for")
                elif defined[v][1] == "${" + v + "}" and "${" + v + "}" not in helper:
                    problems.append(
                        f"${{{v}}} is a secret placeholder (left for the VM to fill), but {HELPER} never "
                        f"substitutes it: add it there, and to SECRETS in tests/check")
    return problems


def render(fixture, out):
    r = subprocess.run(["ansible-playbook", "-i", "localhost,", os.path.join(HERE, "render.yml"),
                        "-e", f"@{fixture}", "-e", f"out={out}"], capture_output=True, text=True)
    if r.returncode != 0:
        print(r.stdout[-3000:], r.stderr[-3000:], sep="\n")
        return False
    with open(fixture) as fh:
        secrets = yaml.safe_load(fh)["secrets"]
    for final, names in SECRETS.items():
        with open(os.path.join(out, final + ".stage"), "rb") as fh:
            text = fh.read().decode()
        for n in names:
            text = text.replace("${" + n + "}", secrets[n])
        with open(os.path.join(out, final), "wb") as fh:
            fh.write(text.encode())
        os.remove(os.path.join(out, final + ".stage"))
    return True


def fetch_tools():
    """TOOLS for this machine, each downloaded once and checked against its
    pinned sha256, in a cache directory named for the pins; returns that
    directory. Raises SystemExit, saying why, if it can't."""
    machine = {"amd64": "x86_64", "arm64": "aarch64"}.get(platform.machine().lower(), platform.machine())
    tools = TOOLS.get(machine) if platform.system() == "Linux" else None
    if tools is None:
        raise SystemExit(f"tests/check: the Alloy checks need Linux on {' or '.join(TOOLS)} (TOOLS), not "
                         f"{platform.system()} {platform.machine()}")
    cache = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    pins = hashlib.sha256("".join(sha for _, sha, _ in tools.values()).encode()).hexdigest()[:16]
    bindir = os.path.join(cache, "gitea-vm-checks", pins)
    os.makedirs(bindir, exist_ok=True)
    for name, (url, sha, member) in tools.items():
        dst = os.path.join(bindir, name)
        if os.path.isfile(dst):
            continue
        # Streamed to disk and hashed on the way: Alloy is ~570 MB unpacked.
        download = dst + ".download"
        for attempt in range(3):
            try:
                h = hashlib.sha256()
                with urllib.request.urlopen(url, timeout=120) as r, open(download, "wb") as fh:
                    for chunk in iter(lambda: r.read(1 << 20), b""):
                        h.update(chunk)
                        fh.write(chunk)
                break
            except OSError as e:
                if attempt == 2:
                    raise SystemExit(f"tests/check: could not download {url}: {e}")
                time.sleep(10)
        if h.hexdigest() != sha:
            os.remove(download)
            raise SystemExit(f"tests/check: {url} has sha256 {h.hexdigest()}, not the pinned {sha}")
        tmp = dst + ".tmp"
        if member:
            with zipfile.ZipFile(download) as zf, zf.open(member) as src, open(tmp, "wb") as fh:
                shutil.copyfileobj(src, fh, 1 << 20)
            os.remove(download)
        else:
            os.replace(download, tmp)
        os.chmod(tmp, 0o755)
        os.replace(tmp, dst)
    return bindir


def free_port():
    """A loopback port nothing listens on now, for the scrub harness's Alloy, so
    two runs on one machine don't collide on a fixed one."""
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def caddy_duration(text):
    """Seconds in a Caddy duration such as 5s, 500ms or 1m30s; None if it isn't
    one."""
    if text == "0":
        return 0.0
    if not re.fullmatch(f"(?:{CADDY_DURATION_PART})+", text):
        return None
    return sum(float(n) * CADDY_DURATION_UNITS[u] for n, u in re.findall(CADDY_DURATION_PART, text))


def systemd_seconds(text):
    """Seconds in a systemd time span such as 90, 90s or 1min 30s (infinity is
    float("inf")); None if it isn't one."""
    if text == "infinity":
        return float("inf")
    if not re.fullmatch(f"(?:{SYSTEMD_TIME_PART})+\\s*", text):
        return None
    parts = re.findall(SYSTEMD_TIME_PART, text)
    if any(u not in SYSTEMD_TIME_UNITS for _, u in parts):
        return None
    return sum(float(n) * SYSTEMD_TIME_UNITS[u] for n, u in parts)


def caddy_global_options(path):
    """A Caddyfile's global options, {name: [arguments]}: the block that opens
    with a bare { before the first site, if there is one. Comments are left
    out, and so are the options of a block nested in it (servers { }, say)."""
    options, depth = {}, 0
    with open(path) as fh:
        for line in fh:
            words = line.split()
            # A comment starts at a word that starts with #.
            words = words[:next((i for i, w in enumerate(words) if w.startswith("#")), len(words))]
            if not words:
                continue
            if depth == 0:
                if words != ["{"]:
                    return options  # a site: there is no global block
                depth = 1
                continue
            if depth == 1 and words == ["}"]:
                return options
            if depth == 1:
                options[words[0]] = words[1:]
            code = " ".join(words)
            depth += code.count("{") - code.count("}")
    return options


def unit_keys(path):
    """A systemd unit file's keys, {section: {key: value}}, the last one where
    a key repeats. Comments are left out."""
    sections, keys = {}, None
    with open(path) as fh:
        for line in fh:
            line = line.strip()
            if not line or line[0] in "#;":
                continue
            if line.startswith("[") and line.endswith("]"):
                keys = sections.setdefault(line[1:-1], {})
            elif keys is not None and "=" in line:
                key, value = line.split("=", 1)
                keys[key.strip()] = value.strip()
    return sections


def caddy_stop_budget():
    """Problems with Caddy's stop budget in every fixture's goldens, which the
    caller has just proved are exactly what renders.

    On a stop, podman sends Caddy (PID 1 in its container) SIGTERM, and
    SIGKILLs it StopTimeout seconds later. Caddy waits shutdown_delay, then up
    to grace_period for open connections to close; with no grace_period it
    waits forever, and a browser's idle HTTP/3 connection is closed only by the
    browser. So the Caddyfile must set one, shutdown_delay + grace_period +
    CADDY_STOP_MARGIN must fit in caddy.container's StopTimeout, written out
    rather than left to podman's default, and that must be under the unit's
    TimeoutStopSec, past which systemd kills the lot."""
    problems = []
    for name in sorted(os.listdir(os.path.join(HERE, "golden"))):
        d = os.path.join(HERE, "golden", name)
        options = caddy_global_options(os.path.join(d, CADDYFILE + ".golden"))
        unit = unit_keys(os.path.join(d, CADDY_QUADLET + ".golden"))

        delay = 0.0
        if "shutdown_delay" in options:
            delay = caddy_duration(" ".join(options["shutdown_delay"]))
            if delay is None:
                problems.append(f"{name}/{CADDYFILE}: shutdown_delay {' '.join(options['shutdown_delay'])!r} "
                                "is not a Caddy duration (5s, 500ms)")
        grace = None
        if "grace_period" not in options:
            problems.append(f"{name}/{CADDYFILE}: the global options set no grace_period, so on a stop Caddy "
                            "waits forever for open connections (idle HTTP/3 ones among them) and podman SIGKILLs "
                            "it at StopTimeout (status 137): add one to vm/config/Caddyfile.tmpl")
        else:
            grace = caddy_duration(" ".join(options["grace_period"]))
            if grace is None:
                problems.append(f"{name}/{CADDYFILE}: grace_period {' '.join(options['grace_period'])!r} "
                                "is not a Caddy duration (5s, 500ms)")

        stop = unit.get("Container", {}).get("StopTimeout")
        if stop is None:
            problems.append(f"{name}/{CADDY_QUADLET}: [Container] sets no StopTimeout=: write it out (podman's "
                            "default is 10), so this check can hold Caddy's grace period under it")
        elif not stop.isdigit():
            problems.append(f"{name}/{CADDY_QUADLET}: StopTimeout={stop} is not a whole number of seconds")
            stop = None
        else:
            stop = int(stop)

        set_limit = unit.get("Service", {}).get("TimeoutStopSec")
        limit = SYSTEMD_STOP_TIMEOUT if set_limit is None else systemd_seconds(set_limit)
        if limit is None:
            problems.append(f"{name}/{CADDY_QUADLET}: TimeoutStopSec={set_limit} is not a systemd time span")

        if None not in (stop, delay, grace) and delay + grace + CADDY_STOP_MARGIN > stop:
            problems.append(f"{name}: shutdown_delay {delay:g}s + grace_period {grace:g}s + {CADDY_STOP_MARGIN}s "
                            f"margin is over caddy.container's StopTimeout={stop}: podman would SIGKILL Caddy "
                            "(status 137) before it finishes")
        if None not in (stop, limit) and not stop < limit:
            what = f"TimeoutStopSec={set_limit}" if set_limit is not None else \
                f"TimeoutStopSec (unset: systemd's {SYSTEMD_STOP_TIMEOUT}s)"
            problems.append(f"{name}/{CADDY_QUADLET}: StopTimeout={stop} is not under {what}: systemd would "
                            "kill the unit before podman stops Caddy")
    return problems


def telemetry_checks(mode):
    """The telemetry checks, run on the goldens, which the caller has just
    proved are exactly what renders; returns what failed. The ones that need
    Alloy run only in strict mode (run_mode)."""
    env = dict(os.environ)
    failures = []

    def run(what, cmd, quiet=False):
        r = subprocess.run(cmd, env=env, capture_output=True, text=True)
        if r.returncode != 0:
            print(r.stdout[-3000:], r.stderr[-3000:], sep="\n")
            failures.append(what)
        elif not quiet:
            print(r.stdout, end="")
        return r.returncode == 0

    # Nothing to download: everywhere.
    run("peer script", ["bash", os.path.join(ROOT, "scripts", "check-peer-config.sh")])
    if run("tunnel state", ["ansible-playbook", "-i", "localhost,", os.path.join(HERE, "tunnel-state.yml")],
           quiet=True):
        print("tunnel state: role tunnel comes to the right state in every case")
    goldens = sorted(os.listdir(os.path.join(HERE, "golden")))
    for name in goldens:
        run(f"{name}: metadata guard", ["bash", os.path.join(ROOT, "scripts", "check-metadata-guard.sh"), "--static"]
            + [os.path.join(HERE, "golden", name, f + ".golden")
               for f in ("nftables.conf", "alloy.container", "gitea.container", "caddy.container")])

    if mode == "deploy":
        print("tests/check: a deploy or vm-check/vm-apply: alloy fmt/validate and the scrub rules are skipped "
              "(they need Alloy from github.com; the PR preview ran them, and `make check` does)")
        return failures

    env["PATH"] = fetch_tools() + os.pathsep + env.get("PATH", "")
    for name in goldens:
        golden = os.path.join(HERE, "golden", name, ALLOY_CONFIG + ".golden")
        with tempfile.TemporaryDirectory() as t:
            # Alloy reads a file by its .alloy name.
            cfg = os.path.join(t, ALLOY_CONFIG)
            shutil.copyfile(golden, cfg)
            run(f"{name}: alloy fmt", ["alloy", "fmt", "--test", cfg])
            run(f"{name}: alloy validate", ["alloy", "validate", cfg])
    # The scrub block renders the same from every fixture: it has no ${VAR}.
    # A port of its own, and up to 5 minutes for Alloy to start and get the
    # fixture through, on a slow builder.
    env["ALLOY_TEST_PORT"] = str(free_port())
    env.setdefault("ALLOY_TEST_TIMEOUT", "300")
    run("scrub rules", [os.path.join(ROOT, "scripts", "check-alloy-scrub.sh"),
                        os.path.join(HERE, "golden", goldens[0], ALLOY_CONFIG + ".golden"), SCRUB_FIXTURE])
    return failures


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--update", action="store_true", help="rewrite the goldens from what renders now")
    a = p.parse_args()

    problems = check_variables()
    if problems:
        print("template variables:\n  " + "\n  ".join(problems))
        return 1

    failures, checked, written = [], 0, 0
    for name in sorted(os.listdir(os.path.join(HERE, "golden"))):
        d = os.path.join(HERE, "golden", name)
        with tempfile.TemporaryDirectory() as out:
            if not render(os.path.join(d, "fixture.yml"), out):
                failures.append(f"{name}: render.yml failed")
                continue
            rendered = sorted(os.listdir(out))
            if a.update:
                for f in rendered:
                    with open(os.path.join(out, f), "rb") as src, open(os.path.join(d, f + ".golden"), "wb") as dst:
                        dst.write(src.read())
                    written += 1
                for g in sorted(x for x in os.listdir(d) if x.endswith(".golden")):
                    if g[: -len(".golden")] not in rendered:
                        os.remove(os.path.join(d, g))  # no longer rendered
                continue
            goldens = sorted(x[: -len(".golden")] for x in os.listdir(d) if x.endswith(".golden"))
            for f in sorted(set(rendered) | set(goldens)):
                checked += 1
                gpath, rpath = os.path.join(d, f + ".golden"), os.path.join(out, f)
                want = open(gpath, "rb").read() if os.path.exists(gpath) else None
                got = open(rpath, "rb").read() if os.path.exists(rpath) else None
                if want is None or got is None:
                    failures.append(f"{name}/{f}: {'no golden' if want is None else 'no longer rendered'}")
                elif got != want:
                    sys.stdout.writelines(difflib.unified_diff(
                        want.decode().splitlines(True), got.decode().splitlines(True),
                        f"golden/{name}/{f}.golden", "rendered"))
                    failures.append(f"{name}/{f}")
    if failures:
        print("golden mismatches: " + ", ".join(failures))
        print("intended? `make goldens` rewrites them; review the golden diff in the PR")
        return 1
    if a.update:
        print(f"tests/check: wrote {written} goldens; review `git diff vm/ansible/tests/golden`")
        return 0
    print(f"tests/check: {checked} rendered files match their goldens")
    problems = caddy_stop_budget()
    if problems:
        print("Caddy's stop budget:\n  " + "\n  ".join(problems))
        return 1
    print(f"tests/check: Caddy's stop budget holds in every fixture: shutdown_delay + grace_period + "
          f"{CADDY_STOP_MARGIN}s <= StopTimeout < TimeoutStopSec")
    mode = run_mode()
    failures = telemetry_checks(mode)
    if failures:
        print("telemetry check failures: " + ", ".join(failures))
        return 1
    print(f"tests/check: the telemetry checks pass ({mode} mode)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
