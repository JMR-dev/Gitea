#!/usr/bin/env bash
# Renders the files that hold secrets -- app.ini, the Caddyfile (its ACME
# contact) and the runner registration token -- on the VM itself, so no secret
# ever reaches the machine running Ansible. The app role ships and runs this
# (ansible.builtin.script) on every run; it is never installed.
#
#   gitea-render-secrets [--check] runner-token PROJECT PREFIX
#   gitea-render-secrets [--check] app-ini      PROJECT PREFIX IMAGE
#   gitea-render-secrets [--check] caddyfile    PROJECT PREFIX
#
# app-ini and caddyfile take the file from GITEA_RENDER_INPUT: rendered by
# Ansible with every non-secret value filled in and ${...} placeholders for
# the secrets. The secrets are read from Secret Manager as the VM's service
# account and substituted here with envsubst, exactly as vm/bootstrap.sh did.
#
# Prints a status line -- changed, unchanged or would-change -- and for
# runner-token a second one, present or absent (the file, afterwards). On a
# change, a diff follows with every secret value masked back to its
# placeholder. A value is never printed. --check never writes anything and
# never adds a secret version. Exit 3: a secret Gitea needs is missing.
set -euo pipefail

check=0
if [[ "${1:-}" == "--check" ]]; then check=1; shift; fi
what=${1:?what}
project=${2:?project}
prefix=${3:?prefix}
umask 077

secret() {
    gcloud secrets versions access latest --secret="$1" --project="${project}" 2>/dev/null
}

# install_if_changed DST OWNER MODE CONTENT [masked-new masked-old]: writes
# CONTENT to DST only if it differs, and prints the status (and a masked diff).
install_if_changed() {
    local dst="$1" owner="$2" mode="$3" content="$4"
    if [[ -f "${dst}" ]] && cmp -s <(printf '%s' "${content}") "${dst}"; then
        echo unchanged
        return 0
    fi
    if (( check )); then echo would-change; else echo changed; fi
    if (( $# > 4 )); then
        diff -u --label "${dst}" --label "${dst} (new)" <(printf '%s' "$6") <(printf '%s' "$5") || true
    fi
    (( check )) && return 0
    local tmp
    tmp=$(mktemp "${dst}.XXXXXX")
    printf '%s' "${content}" > "${tmp}"
    chown "${owner}" "${tmp}"
    chmod "${mode}" "${tmp}"
    mv -f "${tmp}" "${dst}"
}

# mask TEXT NAME=VALUE...: TEXT with each VALUE replaced by ${NAME}.
mask() {
    local text="$1" pair
    shift
    for pair in "$@"; do
        local name=${pair%%=*} value=${pair#*=}
        [[ -n "${value}" ]] && text=${text//"${value}"/"\${${name}}"}
    done
    printf '%s' "${text}"
}

# Reads a Gitea secret from Secret Manager. If it has no version yet, generates
# one -- but ONLY if a Gitea image is available locally to generate it with.
# INTERNAL_TOKEN must be a valid Gitea-issued JWT, so this cannot be a random
# string. Normally scripts/bootstrap.sh has populated these; this is the
# safety net, and --check never uses it.
fetch_or_create() {
    local name="$1" key="$2" image="$3" value=""
    if value=$(secret "${name}") && [[ -n "${value}" ]]; then
        printf '%s' "${value}"
        return 0
    fi
    (( check )) && return 1
    podman image exists "${image}" 2>/dev/null || return 1
    echo "generating missing secret ${name}" >&2
    value=$(podman run --rm "${image}" generate secret "${key}") || return 1
    printf '%s' "${value}" \
        | gcloud secrets versions add "${name}" --project="${project}" --data-file=- >/dev/null || return 1
    printf '%s' "${value}"
}

case "${what}" in
runner-token)
    # Read, never generated: scripts/bootstrap.sh owns this secret, and the GKE
    # runners must see the same value. On a failed read an existing file is
    # KEPT: a transient Secret Manager error should not restart Gitea, and
    # already-registered runners do not use the token anyway.
    dst=/etc/gitea/runner-token
    if value=$(secret "${prefix}-runner-registration-token") && [[ -n "${value}" ]]; then
        install_if_changed "${dst}" 1000:1000 0400 "${value}"
    else
        [[ -f "${dst}" ]] && echo "runner registration token unreadable -- keeping the existing ${dst}" >&2
        echo unchanged
    fi
    if [[ -f "${dst}" ]] || { (( check )) && [[ -n "${value:-}" ]]; }; then echo present; else echo absent; fi
    ;;

app-ini)
    image=${4:?image}
    pairs=()
    for s in secret-key:SECRET_KEY:GITEA_SECRET_KEY internal-token:INTERNAL_TOKEN:GITEA_INTERNAL_TOKEN \
             oauth2-jwt-secret:JWT_SECRET:GITEA_OAUTH2_JWT_SECRET lfs-jwt-secret:LFS_JWT_SECRET:GITEA_LFS_JWT_SECRET; do
        IFS=: read -r suffix key var <<<"${s}"
        # Writing an app.ini with an empty SECRET_KEY or INTERNAL_TOKEN would
        # be far worse than not writing it: broken sessions and tokens.
        if ! value=$(fetch_or_create "${prefix}-${suffix}" "${key}" "${image}"); then
            echo "secret ${prefix}-${suffix} is unavailable -- app.ini not rendered" >&2
            exit 3
        fi
        export "${var}=${value}"
        pairs+=("${var}=${value}")
    done
    input=${GITEA_RENDER_INPUT:?GITEA_RENDER_INPUT}
    out=$(envsubst '${GITEA_SECRET_KEY} ${GITEA_INTERNAL_TOKEN} ${GITEA_OAUTH2_JWT_SECRET} ${GITEA_LFS_JWT_SECRET}' \
          <<<"${input}"; printf x)
    out=${out%$'\nx'}  # <<< adds a newline and $() strips trailing ones: undo both
    old=""
    [[ -f /etc/gitea/app.ini ]] && old=$(cat /etc/gitea/app.ini; printf x) && old=${old%x}
    # app.ini is 0400 owned by uid 1000: it holds SECRET_KEY and INTERNAL_TOKEN,
    # and the container runs as that uid and must be able to read it.
    install_if_changed /etc/gitea/app.ini 1000:1000 0400 "${out}" "${input}" "$(mask "${old}" "${pairs[@]}")"
    ;;

caddyfile)
    # The ACME contact address lives in Secret Manager rather than instance
    # metadata, to keep it out of the public repository. Without it Caddy
    # still issues certificates, just under an account with no contact
    # address -- far better than an empty `email` directive, which fails to
    # parse and leaves nothing serving TLS.
    if email=$(secret "${prefix}-acme-email") && [[ -n "${email}" ]]; then
        CADDY_EMAIL="email ${email}"
    else
        echo "secret ${prefix}-acme-email unreadable -- Caddy will register without a contact address" >&2
        CADDY_EMAIL="# no ACME contact address: secret ${prefix}-acme-email was unreadable at render time"
    fi
    export CADDY_EMAIL
    input=${GITEA_RENDER_INPUT:?GITEA_RENDER_INPUT}
    out=$(envsubst '${CADDY_EMAIL}' <<<"${input}"; printf x)
    out=${out%$'\nx'}
    old=""
    [[ -f /etc/caddy/Caddyfile ]] && old=$(cat /etc/caddy/Caddyfile; printf x) && old=${old%x}
    install_if_changed /etc/caddy/Caddyfile root:root 0644 "${out}" "${input}" "$(mask "${old}" "CADDY_EMAIL=${CADDY_EMAIL}")"
    ;;

*)
    echo "unknown: ${what}" >&2
    exit 2
    ;;
esac
