#!/usr/bin/env bash
# Installs this VM's peer config for the watchtower VPN -- its WireGuard
# config, private key and all -- as /etc/wireguard/wg-watchtower.conf (root,
# 0600), on the VM itself, so the config never reaches the machine running
# Ansible. Role tunnel ships and runs it (ansible.builtin.script, no_log) on
# every run, the way role app runs gitea-render-secrets; it is never installed.
#
#   gitea-watchtower-peer [--check] [SECRET]
#
# SECRET is the instance metadata watchtower-peer-secret (Pulumi's
# gitea:watchtowerPeerSecret): a secret's resource name,
# projects/<project>/secrets/<id>, never a value. It is read here as the VM's
# own service account (gitea-vm@), the one identity granted it. The contract
# is watchtower-observability-stack's docs/client-telemetry.md.
#
# Prints one line, its first word the state roles tunnel and logship act on:
#   up changed|unchanged|would-change   a config that passed the checks below
#   off                                 no SECRET: no peer configured
#   down                                the secret, or its latest version, is
#                                       missing, or the value is empty
#   keep <why>                          anything else (the network, the API,
#                                       the token, PERMISSION_DENIED, a config
#                                       that fails the checks): leave the
#                                       tunnel and Alloy as they are
# and nothing else: never the config, never gcloud's own error text. --check
# reads and checks, and installs nothing. Exits 0 whatever the state, 2 on a
# usage error.
#
# Touches: a private directory under /run (tmpfs) while it runs, and, unless
# --check, /etc/wireguard/wg-watchtower.conf. Nothing else.
#
# The config is moved only between files: fetched into a 0700 directory in
# /run, checked by awk, which writes a fresh copy beside it, then installed.
# Never run this with -x.
set -euo pipefail

readonly WG_IFACE=wg-watchtower
WG_DIR=/etc/wireguard
WG_CONF=${WG_DIR}/${WG_IFACE}.conf
# Where the fetched config waits to be checked: tmpfs, so it never reaches a
# disk until it has passed.
WORK_BASE=/run

# Why fetch_peer returned 1: words of ours, nothing from gcloud.
PEER_FETCH_ERROR=""

# check_peer SRC DST: checks the peer config in SRC and writes it, normalised,
# to DST. Returns 1, writing nothing, on a config to refuse. Prints nothing
# from either file.
#
# Watchtower's deploy pins all of this before it publishes a peer, but the
# file runs here as root (wg-quick runs its hooks), so it is checked again. A
# wider route, or an address over the metadata server's, would send
# 169.254.169.254 into the tunnel and take the VM's credentials, image pulls
# and DNS-01 with it.
#
# wg-quick and wg don't read a line as written: wg deletes every blank in it
# (`Allowed IPs` is AllowedIPs, `[ Peer ]` is [Peer]) and bash's read drops NUL
# bytes (`Post\0Up` is PostUp). So nothing but printable ASCII, tabs and
# newlines gets in, each line is judged the way wg reads it (cut at "#", blanks
# gone, keys in any case), and the output is written afresh from the values
# checked, so nothing else in the file reaches wg-quick:
#   - one [Interface], then one [Peer];
#   - PrivateKey, PublicKey and an optional PresharedKey, each a well-formed
#     key: wg prints a bad one whole in its error, and that goes to the journal;
#   - Address, a /32 in the agent half (10.8.0.128/25);
#   - AllowedIPs, exactly 10.8.0.0/24, once, and an Endpoint;
#   - MTU and PersistentKeepalive, if there, must be numbers, and are written
#     as watchtower sets them for every agent: 1380 and 25;
#   - DNS is dropped: the tunnel is split, and the host keeps its own resolver.
# Any other key is refused: PreUp, PostUp, PreDown, PostDown (commands wg-quick
# runs), Table, FwMark, SaveConfig, and whatever else may come along.
check_peer() {
    local src="$1" dst="$2"
    [[ $(LC_ALL=C tr -d '\t\n\040-\176' < "${src}" | wc -c) -eq 0 ]] || return 1
    # END writes the file, so a refusal writes nothing. A key decodes to 32
    # bytes, so its 43rd character has its last two bits clear; wg checks that.
    LC_ALL=C awk '
        function refuse() { bad = 1; exit 1 }
        function is_key(v) {
            return length(v) == 44 && v ~ /^[A-Za-z0-9+\/]+[AEIMQUYcgkosw048]=$/
        }
        {
            line = $0
            sub(/#.*/, "", line)
            gsub(/[ \t]/, "", line)
            if (line == "") next
            lower = tolower(line)
            if (lower == "[interface]") {
                if (section != "") refuse()
                section = "interface"
                next
            }
            if (lower == "[peer]") {
                if (section != "interface") refuse()
                section = "peer"
                next
            }
            eq = index(line, "=")
            if (eq < 2 || section == "") refuse()
            key = section "/" substr(lower, 1, eq - 1)
            value = substr(line, eq + 1)
            if (key == "interface/dns") next
            if (key in conf) refuse()
            if (key == "interface/privatekey" || key == "peer/publickey" || key == "peer/presharedkey") {
                if (!is_key(value)) refuse()
            } else if (key == "interface/address") {
                if (value !~ /^10\.8\.0\.(12[89]|1[3-9][0-9]|2[0-4][0-9]|25[0-4])\/32$/) refuse()
            } else if (key == "peer/allowedips") {
                if (value != "10.8.0.0/24") refuse()
            } else if (key == "peer/endpoint") {
                if (value !~ /^([A-Za-z0-9.-]+|\[[0-9A-Fa-f:]+\]):[0-9]+$/) refuse()
            } else if (key == "interface/mtu" || key == "peer/persistentkeepalive") {
                if (value !~ /^[0-9]+$/) refuse()
            } else {
                refuse()
            }
            conf[key] = value
        }
        END {
            if (bad || section != "peer") exit 1
            if (!("interface/privatekey" in conf) || !("interface/address" in conf) \
                || !("peer/publickey" in conf) || !("peer/allowedips" in conf) \
                || !("peer/endpoint" in conf)) exit 1
            print "# Installed by the playbook (vm/ansible, role tunnel) from Secret Manager,"
            print "# checked and written afresh. Do not edit: the next run replaces it."
            print "[Interface]"
            print "PrivateKey = " conf["interface/privatekey"]
            print "Address = " conf["interface/address"]
            print "MTU = 1380"
            print ""
            print "[Peer]"
            print "PublicKey = " conf["peer/publickey"]
            if ("peer/presharedkey" in conf) print "PresharedKey = " conf["peer/presharedkey"]
            print "AllowedIPs = " conf["peer/allowedips"]
            print "PersistentKeepalive = 25"
            print "Endpoint = " conf["peer/endpoint"]
        }
    ' "${src}" > "${dst}"
}

# fetch_peer PROJECT SECRET FILE: reads the secret's latest version into FILE.
# Returns 0 with it there, 2 when the secret or its version is missing or the
# value is empty (blanks only counts as empty), and 1 on any other error,
# naming it in PEER_FETCH_ERROR.
#
# The value goes only to the file. gcloud's stderr goes only to a local
# variable, which is matched and never printed.
fetch_peer() {
    local project="$1" secret="$2" dst="$3" err
    if err=$(gcloud secrets versions access latest --secret="${secret}" \
            --project="${project}" 2>&1 >"${dst}"); then
        grep -q '[^[:space:]]' "${dst}" || return 2
        return 0
    fi
    case "${err}" in
        *NOT_FOUND*) return 2 ;;
        # gitea-vm@'s access is granted on the secret itself, so a deleted
        # secret reads as denied too, not as missing.
        *PERMISSION_DENIED*) PEER_FETCH_ERROR="permission denied (a deleted secret reads like this too)" ;;
        *) PEER_FETCH_ERROR="a network, API or credentials error" ;;
    esac
    return 1
}

main() {
    local check=0 resource project secret work rc=0 tmp
    if [[ "${1:-}" == "--check" ]]; then check=1; shift; fi
    if (( $# > 1 )); then
        echo "usage: gitea-watchtower-peer [--check] [projects/<project>/secrets/<id>]" >&2
        return 2
    fi
    resource=${1:-}
    if [[ -z "${resource}" ]]; then
        echo off
        return 0
    fi
    if [[ ! "${resource}" =~ ^projects/([a-z][a-z0-9-]{4,28}[a-z0-9])/secrets/([A-Za-z0-9_-]{1,255})$ ]]; then
        echo "keep the watchtower-peer-secret metadata is not a secret's resource name (projects/<project>/secrets/<id>)"
        return 0
    fi
    project=${BASH_REMATCH[1]}
    secret=${BASH_REMATCH[2]}

    umask 077
    # Left behind only by a run that was killed half-way.
    rm -rf "${WORK_BASE}"/gitea-watchtower-peer.*
    work=$(mktemp -d "${WORK_BASE}/gitea-watchtower-peer.XXXXXX")
    # shellcheck disable=SC2064 # expand now: work is local
    trap "rm -rf '${work}'" EXIT

    fetch_peer "${project}" "${secret}" "${work}/raw" || rc=$?
    case "${rc}" in
        0) ;;
        2)
            echo down
            return 0
            ;;
        *)
            echo "keep could not read ${resource}: ${PEER_FETCH_ERROR}"
            return 0
            ;;
    esac
    if ! check_peer "${work}/raw" "${work}/conf"; then
        echo "keep the peer config in ${resource} failed its checks (a split tunnel to 10.8.0.0/24 only, no hooks or other settings, well-formed keys) and was refused"
        return 0
    fi

    if [[ -f "${WG_CONF}" ]] && cmp -s "${work}/conf" "${WG_CONF}"; then
        echo "up unchanged"
        return 0
    fi
    if (( check )); then
        echo "up would-change"
        return 0
    fi
    # Written beside the target and renamed over it, so wg-quick never reads a
    # half-written file.
    install -d -m 0700 "${WG_DIR}"
    tmp=$(mktemp "${WG_DIR}/.${WG_IFACE}.XXXXXX")
    cat "${work}/conf" > "${tmp}"
    mv -f "${tmp}" "${WG_CONF}"
    restorecon -F "${WG_CONF}" >/dev/null 2>&1 || true
    echo "up changed"
}

# Sourced by scripts/check-peer-config.sh, which runs these functions over
# made-up configs and stubs; run, it does the work.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
